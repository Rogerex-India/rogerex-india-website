          "name": "Submit Application (Valid)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "pm.test('Response structure is correct', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.success).to.be.true;",
                  "  pm.expect(body.message).to.include('successfully');",
                  "  pm.expect(body.data).to.have.property('id');",
                  "  pm.expect(body.data).to.have.property('name');",
                  "  pm.expect(body.data).to.have.property('role');",
                  "  pm.expect(body.data).to.have.property('status');",
                  "  pm.expect(body.data).to.have.property('appliedAt');",
                  "  pm.expect(body.data.status).to.equal('Application Received');",
                  "  pm.collectionVariables.set('applicationId', body.data.id);",
                  "  console.log('Application ID saved:', body.data.id);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Rahul Sharma\",\n  \"email\": \"rahul.sharma.test@example.com\",\n  \"phone\": \"9876543210\",\n  \"college\": \"ABC University\",\n  \"degree\": \"B.Tech CSE\",\n  \"graduationYear\": 2027,\n  \"role\": \"Frontend Developer Intern\",\n  \"linkedin\": \"https://linkedin.com/in/rahul\",\n  \"github\": \"https://github.com/rahul\"\n}"
